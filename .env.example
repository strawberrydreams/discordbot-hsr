# ── .env.secrets — 자격증명만 ──
DISCORD_TOKEN=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# 선택 사항: 설정하면 고정된 127.0.0.1:8080 웹 관리가 켜진다. 실제 secret은 적지 않는다.
ADMIN_TOKEN=

# ── .env.runtime — 경로·동작 ──
DATA_DIR=runtime/data
BACKUP_DIR=runtime/backups
SETTINGS_DIR=settings
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30
AI_COOLDOWN_SECONDS=15
DB_BACKEND=sqlite
CHAT_MODEL_LIGHT=gpt-5.6-terra
CHAT_MODEL_DEEP=gpt-5.6-sol
IMAGE_MODEL=gemini-3.1-flash-image
LIMIT_LIGHT=10
LIMIT_DEEP=3
LIMIT_IMAGE=3
